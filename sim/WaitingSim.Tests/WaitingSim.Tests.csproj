<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- xunit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WaitingSim\WaitingSim.csproj" />
    <ProjectReference Include="..\WaitingSim.Runner\WaitingSim.Runner.csproj" />
    <!-- The client's engine-free parts (driver, head, floor mapping, data loading) are tested here; nothing in a test
         touches a Godot node, so no engine runs. -->
    <ProjectReference Include="..\..\game\WaitingSimulator.Game.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The shipped data files, copied as they are so tests load what the game loads. -->
    <None Include="..\..\data\**\*.json" LinkBase="data" CopyToOutputDirectory="PreserveNewest" />
    <!-- Golden replays: recorded command streams whose state hashes must not change. -->
    <None Include="Replays\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
