<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- xunit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WaitingSim\WaitingSim.csproj" />
    <ProjectReference Include="..\WaitingSim.Runner\WaitingSim.Runner.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The shipped data files, copied as they are so tests load what the game loads. -->
    <None Include="..\..\data\**\*.json" LinkBase="data" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
